    end

    %% ===========================
    %% Connections
    %% ===========================

    %% App → Auth
    POSApp -->|"creates"| LoginWindow
    LoginWindow -->|"opens"| SignUpWindow
    LoginWindow -->|"uses"| Autenticacion
    Autenticacion -->|"delegates to"| PasswordHasher
    Autenticacion -->|"reads/writes via"| ArchivoUsuarios
    ArchivoUsuarios -->|"persists to"| CSVUsuarios

    %% Auth → Main
    LoginWindow -->|"on success\nopens"| MainWindow
    MainWindow -->|"contains"| MenuBar
    MainWindow -->|"opens"| UICustomizationDialog
    UICustomizationDialog -->|"applies"| ThemeHelper
    ThemeHelper -->|"saves"| ThemeINI

    %% Main → Modules (tabs)
    MainWindow -->|"tab: Ventas"| MenuVentas
    MainWindow -->|"tab: Inventario"| MenuInventario
    MainWindow -->|"tab: Reportes\n(admin only)"| MenuReportes

    %% Sales Module
    MenuVentas -->|"uses"| ProcesadorVentas
    MenuVentas -->|"opens"| CantidadFraccionDialog
    MenuVentas -->|"polls"| BarcodeScanner
    ProcesadorVentas -->|"writes via"| ArchivoVentas
    ArchivoVentas -->|"persists to"| TXTVentas

    %% Inventory Module
    MenuInventario -->|"opens"| ProductoForm
    MenuInventario -->|"uses"| Inventario
    Inventario -->|"fast lookup via"| IndexManager
    Inventario -->|"persistent storage via"| DatabaseManager
    Inventario -->|"CSV fallback via"| ArchivoProductos
    DatabaseManager -->|"stores in"| LMDBStore
    ArchivoProductos -->|"reads/writes"| CSVProductos

    %% Reports Module
    MenuReportes -->|"uses"| Reportes
    Reportes -->|"reads"| CSVProductos
    Reportes -->|"reads"| TXTVentas
    Reportes -->|"exports to"| CSVReportes

    %% Shared Models
    Autenticacion -.->|"produces"| Usuario
    Inventario -.->|"manages"| Producto
    ProcesadorVentas -.->|"creates"| Venta

    %% ===========================
    %% Style Classes
    %% ===========================
    classDef entryPoint fill:#007acc,stroke:#005a9e,color:#fff,font-weight:bold
    classDef window fill:#252526,stroke:#007acc,color:#e0e0e0
