    classDef data fill:#3c2f2f,stroke:#f48771,color:#e0e0e0
    classDef model fill:#2f3040,stroke:#569cd6,color:#e0e0e0
    classDef utility fill:#363028,stroke:#dcdcaa,color:#e0e0e0

    class POSApp entryPoint
    class LoginWindow,SignUpWindow,MainWindow,MenuVentas,MenuInventario,MenuReportes,ProductoForm,CantidadFraccionDialog,UICustomizationDialog,MenuBar window
    class Autenticacion,Inventario,ProcesadorVentas,Reportes,IndexManager business
    class ArchivoUsuarios,ArchivoProductos,ArchivoVentas,DatabaseManager data
    class CSVProductos,CSVUsuarios,TXTVentas,CSVReportes,LMDBStore,ThemeINI data
    class Usuario,Producto,Venta model
    class PasswordHasher,ThemeHelper,BarcodeScanner utility
